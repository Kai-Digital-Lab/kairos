---
const lang = Astro.currentLocale || "en";

const translations = {
    en: {
        title: "The Engineer meets The Strategist",
        founder: "Kevin Hsieh - Founder",
        p1: "I combine full-stack engineering with program management, so your project has one accountable owner from the first scoping call through launch.",
        p2: "Every demo on this site is working code you can try yourself, so you can judge how a site behaves before we ever talk.",
        eng: "Engineering",
        engDesc: "React, Node, Cloud Arch",
        strat: "Strategy",
        stratDesc: "PMP, Product Market Fit",
        yearsInTech: "Years in Tech Industry",
        connect: "Connect on LinkedIn",
        skills: [
            "Technical Program Management",
            "Cloud Architecture",
            "Agile & Scrum",
            "Modern Web (Astro/React)",
            "GenAI Workflow",
            "Team Leadership",
        ],
    },
    "zh-tw": {
        title: "工程師與策略家的相遇",
        founder: "Kevin Hsieh - 創辦人",
        p1: "我同時具備全端工程與專案管理背景，從第一次需求訪談到正式上線，您的專案都有一位明確的負責人。",
        p2: "本站的每個範例都是可實際操作的程式，讓您在洽談之前，就能親自確認網站的操作體驗。",
        eng: "工程技術",
        engDesc: "React, Node, Cloud Arch",
        strat: "商業策略",
        stratDesc: "PMP, 產品市場契合度",
        yearsInTech: "科技產業資歷",
        connect: "LinkedIn 連結",
        skills: [
            "技術專案管理",
            "雲端架構",
            "敏捷開發",
            "現代網頁 (Astro/React)",
            "GenAI 工作流",
            "團隊領導",
        ],
    },
};

const locale = lang === "zh-tw" ? "zh-tw" : "en";
const t = translations[locale];
---

<section
    id="about"
    class="py-20 bg-white dark:bg-slate-900 overflow-hidden text-left"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
            <div class="relative">
                <h2
                    class="text-3xl md:text-4xl font-bold font-mono text-slate-900 dark:text-white mb-6"
                >
                    {t.title}
                </h2>
                <h3
                    class="text-xl text-primary-600 dark:text-primary-400 font-medium mb-4"
                >
                    {t.founder}
                </h3>

                <div
                    class="prose prose-lg dark:prose-invert text-slate-600 dark:text-slate-400 mb-8"
                >
                    <p>
                        {t.p1}
                    </p>
                    <p>
                        {t.p2}
                    </p>
                </div>

                <div class="grid sm:grid-cols-3 gap-4 mb-8">
                    <div
                        class="bg-slate-50 dark:bg-slate-800 p-4 rounded border-l-4 border-purple-600 dark:border-purple-500"
                    >
                        <span
                            class="block font-bold text-slate-900 dark:text-white"
                            >20+</span
                        >
                        <span class="text-sm text-slate-500 dark:text-slate-400"
                            >{t.yearsInTech}</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 dark:bg-slate-800 p-4 rounded border-l-4 border-slate-800 dark:border-slate-500"
                    >
                        <span
                            class="block font-bold text-slate-900 dark:text-white"
                            >{t.eng}</span
                        >
                        <span class="text-sm text-slate-500 dark:text-slate-400"
                            >{t.engDesc}</span
                        >
                    </div>
                    <div
                        class="bg-slate-50 dark:bg-slate-800 p-4 rounded border-l-4 border-primary-600 dark:border-primary-500"
                    >
                        <span
                            class="block font-bold text-slate-900 dark:text-white"
                            >{t.strat}</span
                        >
                        <span class="text-sm text-slate-500 dark:text-slate-400"
                            >{t.stratDesc}</span
                        >
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex flex-wrap gap-2">
                        {
                            t.skills.map((skill) => (
                                <span class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md text-sm font-medium border border-slate-200 dark:border-slate-700">
                                    {skill}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <div
                    class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800 flex items-center gap-4"
                >
                    <a
                        href="https://www.linkedin.com/in/kevinhsieh-pmp/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center font-semibold text-primary-600 hover:text-primary-700 transition-colors"
                    >
                        {t.connect}
                        <svg
                            class="w-4 h-4 ml-1"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
