---
import { getEntry } from "astro:content";

const lang = Astro.currentLocale || "en";

// Engagement types come from the pricing collection; example chips
// cross-reference demo layouts in the themes collection.
const pricingEntry = await getEntry("pricing", `pricing-${lang}`);
const plans = pricingEntry?.data ?? [];

const categories = [
    ...new Set(
        plans.flatMap((plan) => plan.exampleThemes.map((e) => e.category)),
    ),
];
const themeEntries = await Promise.all(
    categories.map((category) => getEntry("themes", `${category}-${lang}`)),
);
const themeNames = new Map(
    categories.flatMap((category, i) =>
        (themeEntries[i]?.data ?? []).map(
            (theme) => [`${category}/${theme.id}`, theme.name] as const,
        ),
    ),
);

const resolvedPlans = plans.map((plan) => ({
    ...plan,
    examples: plan.exampleThemes.flatMap(({ category, id }) => {
        const title = themeNames.get(`${category}/${id}`);
        return title
            ? [{ title, href: `/${lang}/explore/${category}/${id}` }]
            : [];
    }),
}));

// UI chrome strings only — plan content comes from the pricing collection
const translations = {
    en: {
        title: "Working Together",
        subtitle:
            "Every project is custom built. These starting points help you budget before we talk.",
        audienceLabel: "Good for",
        examplesLabel: "Demos to try",
        processTitle: "How a project starts",
        steps: [
            {
                title: "Discovery call",
                desc: "We talk through your goals, your audience, and what the site needs to do.",
            },
            {
                title: "Scope & quote",
                desc: "You get a written scope, timeline, and quote before any work begins.",
            },
            {
                title: "Build & launch",
                desc: "You review progress along the way, then we launch together.",
            },
        ],
    },
    "zh-tw": {
        title: "合作方式",
        subtitle: "每個專案都是客製開發。以下起始價格方便您在洽談前先評估預算。",
        audienceLabel: "適合對象",
        examplesLabel: "可試用的範例",
        processTitle: "專案如何開始",
        steps: [
            {
                title: "需求訪談",
                desc: "了解您的目標、受眾，以及網站需要達成的任務。",
            },
            {
                title: "範圍與報價",
                desc: "動工前提供書面的工作範圍、時程與報價。",
            },
            {
                title: "開發與上線",
                desc: "過程中隨時檢視進度，確認後一起上線。",
            },
        ],
    },
};

const t = translations[lang as keyof typeof translations] || translations.en;
---

<section
    id="pricing"
    class="relative py-24 lg:py-32 bg-slate-50 dark:bg-slate-950 overflow-hidden transition-colors duration-500"
>
    <!-- Ambient Background -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-blue-200/40 dark:bg-blue-900/20 rounded-[100%] blur-[120px] -translate-y-1/2 transition-colors duration-500"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-purple-200/40 dark:bg-purple-900/10 rounded-full blur-[100px] translate-y-1/4 -translate-x-1/4 transition-colors duration-500"
        >
        </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2
                class="text-3xl md:text-4xl font-bold font-mono text-slate-900 dark:text-white tracking-tight mb-6 drop-shadow-sm transition-colors"
            >
                {t.title}
            </h2>
            <p
                class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed transition-colors"
            >
                {t.subtitle}
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {
                resolvedPlans.map((plan) => (
                    <div class="flex flex-col p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:shadow-xl transition-all duration-300">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
                            {plan.title}
                        </h3>
                        <p class="text-3xl font-extrabold text-slate-900 dark:text-white mb-6">
                            {plan.price}
                        </p>

                        <p class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                            {t.audienceLabel}
                        </p>
                        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                            {plan.audience}
                        </p>

                        {plan.examples.length > 0 && (
                            <div class="mb-8 pt-4 border-t border-slate-100 dark:border-slate-800">
                                <p class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                    {t.examplesLabel}
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    {plan.examples.map((example) => (
                                        <a
                                            href={example.href}
                                            class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:underline transition-colors"
                                        >
                                            {example.title}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}

                        <a
                            href="#contact"
                            class="mt-auto block w-full py-3 px-6 rounded-lg text-center font-bold bg-primary-600 hover:bg-primary-700 text-white transition-colors"
                        >
                            {plan.cta}
                        </a>
                    </div>
                ))
            }
        </div>

        <div class="mt-20 max-w-6xl mx-auto">
            <h3
                class="text-center text-2xl font-bold text-slate-900 dark:text-white mb-10"
            >
                {t.processTitle}
            </h3>
            <ol class="grid md:grid-cols-3 gap-8">
                {
                    t.steps.map((step, index) => (
                        <li class="flex gap-4">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/30 font-bold text-primary-700 dark:text-primary-300">
                                {index + 1}
                            </span>
                            <div>
                                <p class="font-bold text-slate-900 dark:text-white mb-1">
                                    {step.title}
                                </p>
                                <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                    {step.desc}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>
    </div>
</section>
