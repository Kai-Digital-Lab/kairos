---
import PageLayout from "@/layouts/PageLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Portfolio from "@/components/sections/Portfolio.astro";
import Services from "@/components/sections/Services.astro";
import Pricing from "@/components/sections/Pricing.astro";
import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";

export function getStaticPaths() {
	return [{ params: { lang: "en" } }, { params: { lang: "zh-tw" } }];
}

const { lang } = Astro.params;

const translations = {
	en: { title: "K@i DIGITAL LAB | Custom Websites & Web Apps" },
	"zh-tw": { title: "K@i DIGITAL LAB | 客製網站與系統開發" },
};

const t = translations[lang as keyof typeof translations] || translations.en;
---

<PageLayout title={t.title} lang={lang}>
	<Hero />

	<Portfolio />

	<Services />

	<Pricing />

	<About />

	<Contact />
</PageLayout>
